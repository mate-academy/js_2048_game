# Auto detect text files and perform LF normalization
* text=auto

# Force LF for these files in repository, but allow auto conversion on checkout
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Always use LF for these
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.eslintignore text eol=lf
.prettierignore text eol=lf
.stylelintignore text eol=lf
LICENSE text eol=lf

