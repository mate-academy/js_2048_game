{
  "name": "2048",
  "version": "1.0.0",
  "description": "2048 game",
  "author": "Mate Academy",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=18 <21"
  },
  "scripts": {
    "init": "mate-scripts init",
    "start": "cross-env NODE_ENV=development npx parcel src/index.html --open",
    "build": "npx parcel build src/index.html --public-url ./",
    "style-format": "npx stylelint 'src/**/*.scss' --fix --allow-empty-input",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{html,css,scss}'",
    "lint": "npm run style-format && npm run format && mate-scripts lint",
    "test:only": "mate-scripts test",
    "deploy": "mate-scripts deploy",
    "update": "mate-scripts update",
    "postinstall": "npm run update",
    "test": "npm run lint && npm run test:only"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.5",
    "@mate-academy/eslint-config": "^0.0.29",
    "@mate-academy/scripts": "^2.1.3",
    "@mate-academy/stylelint-config": "^0.0.15",
    "@parcel/transformer-sass": "^2.16.3",
    "cypress": "^4.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-cypress": "^3.3.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "parcel": "^2.10.0",
    "prettier": "^3.3.2",
    "sass": "^1.97.2",
    "stylelint": "^16.7.0",
    "stylelint-scss": "^6.4.1"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.5%",
    "not dead"
  ],
  "mateAcademy": {
    "projectType": "layoutDOM",
    "linters": {
      "bem": false,
      "html": false
    },
    "tests": {
      "jest": false,
      "backstop": false,
      "cypress": true
    }
  }
}
